# Copy this file to local.env and fill in your values.
# local.env is git-ignored; local.env.example is committed.

# --- SSH (Ollama host) ---
SSH_HOST=192.168.1.50
SSH_USER=deploy
# SSH_KEY is optional. If omitted, ssh uses its default key selection.
# SSH_KEY=~/.ssh/id_rsa

# --- Ollama ---
OLLAMA_API_PORT=11434
OLLAMA_LOCAL_PORT=18434
OLLAMA_MODEL=llama3

# --- VM SSH ---
VM_SSH_HOST=192.168.1.51
VM_SSH_USER=deploy
# VM_SSH_KEY is optional. If omitted, ssh uses its default key selection.
# VM_SSH_KEY=~/.ssh/id_rsa

# --- Remote tools (tools.py RPC server on the VM) ---
# VM_ROOT_DIR is the directory on the VM where tools.py is stored and where
# the tools' working directory starts.  ~ (the default) is the VM user's
# home; a sub-directory of it can be chosen with the harness's --dir arg.
VM_ROOT_DIR=~
# TOOLS_REMOTE_PORT is the port tools.py listens on (on the VM).
# TOOLS_LOCAL_PORT is the local port the harness forwards to via ssh -L.
TOOLS_REMOTE_PORT=18435
TOOLS_LOCAL_PORT=18436

# --- Logging ---
# When set, the full message history of each chat session is written to a
# timestamped JSON file in this directory when you quit (Ctrl+C / Ctrl+D).
# Leave it unset (or comment it out) to disable transcript logging.
# LOG_DIR=logs
